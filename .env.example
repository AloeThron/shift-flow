# Shift-Flow — ตัวอย่าง environment (คัดลอกเป็น .env.local)
# อย่า commit ไฟล์ที่มี secret จริง

# --- Application ---
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# สร้างด้วย: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Database ---
# Runtime: pooled endpoint (Neon) หรือ local Postgres
DATABASE_URL=postgresql://shiftflow:shiftflow@localhost:5432/shiftflow?schema=public
# Prisma CLI / migration: direct connection (Neon direct หรือ local เดียวกัน)
DIRECT_URL=postgresql://shiftflow:shiftflow@localhost:5432/shiftflow?schema=public
# neon | local — เลือก driver adapter ตอน runtime
DATABASE_PROVIDER=local

# --- Optional ---
# LOG_LEVEL=info
